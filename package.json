{
  "name": "craftstudio-mcp",
  "version": "1.0.0",
  "description": "AI-specialized lightweight Minecraft building editor & MCP server with Three.js 4-view offscreen ID picker",
  "type": "module",
  "bin": {
    "craftstudio-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "tsx src/mcp/server.ts",
    "generate-sample": "tsx scripts/generate-sample-terrain.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "adm-zip": "^0.5.16",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "prismarine-nbt": "^2.5.0",
    "three": "^0.170.0",
    "vite": "^6.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
