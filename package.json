{
  "name": "mine-building-mcp",
  "version": "1.1.0",
  "description": "MineBuildingMCP: AI-specialized lightweight Minecraft building editor & MCP server with Three.js 4-view offscreen ID picker, interior cutaway renderer, and Java/Bedrock structure support",
  "type": "module",
  "bin": {
    "mine-building-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "tsx src/mcp/server.ts",
    "generate-sample": "tsx scripts/generate-sample-terrain.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "adm-zip": "^0.6.1",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "prismarine-nbt": "^2.8.0",
    "three": "^0.187.0",
    "vite": "^8.3.8",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
